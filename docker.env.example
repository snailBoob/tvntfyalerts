# Copy to docker.env. This file is read by Compose, not baked into the image.
# Local Mac test:
APP_BIND=127.0.0.1
APP_PORT=3080
PUBLIC_URL=http://localhost:3080

# Existing ntfy server: base URL without the topic; set your actual server.
# With compose.ntfy.yml this is overridden by http://ntfy:80.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=tradingview-alerts
NTFY_TOKEN=

# Optional compose.existing-ntfy.yml: same-host ntfy, on its existing network.
NTFY_NETWORK=ntfy_default
NTFY_INTERNAL_URL=http://ntfy:80

# Optional bundled ntfy server (trusted local network, no authentication).
NTFY_BIND=127.0.0.1
NTFY_PORT=8080
NTFY_PUBLIC_URL=http://localhost:8080

# For LAN/Synology: set APP_BIND and NTFY_BIND to 0.0.0.0.
# Set PUBLIC_URL and NTFY_PUBLIC_URL to addresses your phone can reach.
